{
  "name": "proxenos",
  "version": "0.1.1",
  "description": "MCP server that lets Claude Code delegate tasks to Codex CLI workers (ChatGPT subscription or API-key auth) running in isolated git worktrees",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "subagent",
    "orchestration",
    "agent",
    "delegation"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "proxenos": "dist/index.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "picomatch": "^4.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2"
  }
}
